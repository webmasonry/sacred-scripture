{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "preset": "all",
      "source": {
        "noDuplicateClasses": "on",
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedEnumMembers": "on",
        "useSortedInterfaceMembers": "on",
        "useSortedKeys": "on",
        "useSortedPackageJson": "on",
        "useSortedProperties": "on",
        "useSortedSelectionSet": "on",
        "useSortedTypeFields": "on"
      }
    }
  },
  "css": {
    "assist": {
      "enabled": true
    },
    "formatter": {
      "delimiterSpacing": false,
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineEnding": "auto",
      "lineWidth": 80,
      "quoteStyle": "single",
      "trailingNewline": true
    },
    "globals": [],
    "linter": {
      "enabled": true
    },
    "parser": {
      "allowWrongLineComments": true,
      "cssModules": true,
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.astro",
      "**/*.css",
      "**/*.html",
      "**/*.json",
      "**/*.svelte",
      "**/*.ts",
      "**/*.tsx",
      "**/*.vue",
      "./.vscode/@webmasonry.code-workspace"
    ]
  },
  "formatter": {
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "delimiterSpacing": false,
    "enabled": true,
    "expand": "auto",
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "auto",
    "lineWidth": 80,
    "trailingNewline": true,
    "useEditorconfig": false
  },
  "html": {
    "assist": {
      "enabled": true
    },
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "attributePosition": "auto",
      "bracketSameLine": true,
      "enabled": true,
      "indentScriptAndStyle": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineEnding": "auto",
      "lineWidth": 80,
      "selfCloseVoidElements": "always",
      "trailingNewline": true,
      "whitespaceSensitivity": "strict"
    },
    "linter": {
      "enabled": true
    },
    "parser": {
      "interpolation": true,
      "vue": true
    }
  },
  "javascript": {
    "assist": {
      "enabled": true
    },
    "experimentalEmbeddedSnippetsEnabled": true,
    "formatter": {
      "arrowParentheses": "always",
      "attributePosition": "auto",
      "bracketSameLine": true,
      "bracketSpacing": true,
      "delimiterSpacing": false,
      "enabled": true,
      "expand": "auto",
      "indentStyle": "space",
      "indentWidth": 2,
      "jsxQuoteStyle": "double",
      "lineEnding": "auto",
      "lineWidth": 80,
      "operatorLinebreak": "after",
      "quoteProperties": "asNeeded",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "trailingNewline": true
    }
  },
  "json": {
    "assist": {
      "enabled": true
    },
    "formatter": {
      "bracketSpacing": true,
      "delimiterSpacing": false,
      "enabled": true,
      "expand": "auto",
      "indentStyle": "space",
      "indentWidth": 2,
      "lineEnding": "auto",
      "lineWidth": 80,
      "trailingCommas": "none",
      "trailingNewline": true
    },
    "linter": {
      "enabled": true
    },
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": false
    }
  },
  "linter": {
    "domains": {
      "astro": "all",
      "drizzle": "all",
      "playwright": "all",
      "react": "all",
      "tailwind": "all",
      "test": "all",
      "types": "all"
    },
    "enabled": true,
    "rules": {
      "a11y": {
        "recommended": true
      },
      "complexity": {
        "recommended": true
      },
      "correctness": {
        "recommended": true
      },
      "nursery": {
        "recommended": true
      },
      "performance": {
        "recommended": true
      },
      "preset": "recommended",
      "security": {
        "recommended": true
      },
      "style": {
        "recommended": true
      },
      "suspicious": {
        "recommended": true
      }
    }
  },
  "overrides": [
    {
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off"
          }
        }
      },
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAttribute": {
              "level": "error",
              "options": {
                "ignore": ["class:list", "set:html"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.css"]
    },
    {
      "includes": ["**/*.html"]
    },
    {
      "assist": {
        "actions": {
          "source": {
            "useSortedPackageJson": "off"
          }
        }
      },
      "includes": ["**/*.json"]
    },
    {
      "includes": ["**/*.svelte"]
    },
    {
      "includes": ["**/*.ts"]
    },
    {
      "includes": ["**/*.d.ts"]
    },
    {
      "includes": ["**/*.tsx"]
    },
    {
      "includes": ["**/*.vue"]
    }
  ],
  "plugins": [],
  "root": true,
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
