---
import { Icon } from "astro-icon/components";
---

<nav
  aria-label="navigation drawer"
  data-target="navigation drawer"
  id="nav-drawer"
  class:list={[
    "fixed top-[57px] bottom-0 left-0 h-[calc(100svh-57px)] bg-element z-10 overflow-y-auto p-2 hidden border-r border-hairline shadow-xs shadow-accent-brand",
  ]}>
  <ul class:list={["flex flex-col gap-y-2"]}>
    {() => {
      return (
        <>
          <li>
            <a class:list={[Astro.props.styles.buttons]} href="/">
              <Icon name="home" />
            </a>
          </li>
          <li>
            <button
              aria-label="Toggle search"
              aria-pressed="false"
              class:list={[Astro.props.styles.buttons]}
              data-trigger="search toggle"
              type="button">
              <Icon name="search" />
            </button>
          </li>
          <li>
            <button
              aria-label="Toggle bookmark"
              aria-pressed="false"
              class:list={[Astro.props.styles.buttons]}
              data-trigger="bookmark toggle"
              type="button">
              <Icon name="bookmark" />
            </button>
          </li>
          <li>
            <button
              aria-label="Toggle dark theme"
              aria-pressed="false"
              class:list={[Astro.props.styles.buttons]}
              data-trigger="theme toggle"
              type="button">
              <span
                aria-hidden="true"
                class:list={["hidden"]}
                data-trigger="theme light">
                <Icon name="lucide:moon" />
              </span>
              <span
                aria-hidden="false"
                class:list={[""]}
                data-trigger="theme dark">
                <Icon name="lucide:sun" />
              </span>
            </button>
          </li>
        </>
      );
    }}
  </ul>
</nav>
