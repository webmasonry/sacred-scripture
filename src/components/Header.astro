---
import { Icon } from "astro-icon/components";

interface Props {
  bibleDrawer: boolean;
  styles: {
    buttons: string;
  };
}
---

<header class="z-20 fixed top-0 left-0 right-0 shrink-0 flex flex-row items-center justify-center p-2 bg-element border-b border-hairline shadow-xs shadow-accent-brand">
  <button
    aria-controls="navigation drawer"
    aria-expanded="false"
    aria-pressed="false"
    data-trigger="navigation drawer"
    type="button"
    class:list={[Astro.props.styles.buttons]}>
    <Icon name="lucide:menu" />
  </button>

  {Astro.props.bibleDrawer ? (
    <button
      aria-controls="bible drawer"
      aria-expanded="false"
      aria-pressed="false"
      data-trigger="bible drawer"
      type="button"
      class:list={[Astro.props.styles.buttons, "ms-auto"]}>
      <Icon name="bible" />
    </button>
  ) : (
    <a
      class:list={[Astro.props.styles.buttons, "ms-auto"]}
      href="/reader/hrb/genesis/1/">
      <Icon name="bible" />
    </a>
  )}
</header>
