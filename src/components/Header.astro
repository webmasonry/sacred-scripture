---
import { Icon } from "astro-icon/components";

interface Props {
  buttonStyle: string[];
}

const { buttonStyle } = Astro.props;
---

<header
  class:list={[
    "flex flex-row items-center justify-center p-2 bg-element border-b",
    "border-hairline shadow-xs shadow-accent-brand top-0 left-0 right-0",
    "z-100 sticky",
  ]}>
  <!-- Navigation Drawer Trigger -->
  <button
    aria-controls="navigation drawer"
    aria-expanded="false"
    aria-pressed="false"
    data-trigger="navigation drawer"
    type="button"
    class:list={[...buttonStyle]}>
    <Icon name="lucide:menu" />
  </button>

  <!-- Bible Drawer Trigger -->
  <button
    aria-controls="bible drawer"
    aria-expanded="false"
    aria-pressed="false"
    data-trigger="bible drawer"
    type="button"
    class:list={[...buttonStyle, "ms-auto"]}>
    <Icon name="bible" />
  </button>
</header>
