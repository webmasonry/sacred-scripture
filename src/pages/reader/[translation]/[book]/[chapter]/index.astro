---
import "@/styles/global.css";
import { Font } from "astro:assets";
import { getCollection } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { Icon } from "astro-icon/components";

export const prerender = true;
export const getStaticPaths = (async () => {
  const translations = ["erv", "hrb"] as const;
  const generatePathsForTranslation = async (
    translation: (typeof translations)[number],
  ) => {
    const collection = await getCollection(`${translation}-bible`);

    const metadataEntry = collection.find(
      (entry) => entry.data.type === "metadata",
    );

    if (metadataEntry?.data.type !== "metadata") {
      throw new Error(`Missing metadata entry for ${translation} Bible`);
    }

    const { bookNames, chapterNumbersByBook } = metadataEntry.data;

    return collection.flatMap((entry) => {
      if (entry.data.type !== "chapter") return [];
      const chapter = entry.data;
      return [
        {
          params: {
            translation,
            book: chapter.bookName.toLowerCase(),
            chapter: String(chapter.chapterId),
          },
          props: {
            _metadata: {
              bookNames,
              chapterNumbersByBook,
            },
            bookId: chapter.bookId,
            bookName: chapter.bookName.toLowerCase(),
            chapterId: String(chapter.chapterId),
            translation,
            verses: chapter.verses,
          },
        },
      ];
    });
  };

  const pathsByTranslation = await Promise.all(
    translations.map(generatePathsForTranslation),
  );
  return pathsByTranslation.flat();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const buttonStyle = [
  "flex items-center justify-center size-8 text-xl text-subtle",
  "cursor-pointer bg-transparent border border-hairline rounded-lg",
  "transition-all duration-[120ms]",
];
---

<html class="dark scrollbar-none" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width" name="viewport" />
    <meta content={Astro.generator} name="generator" />
    <title>Sacred Scripture</title>
    <Font cssVariable="--font-cinzel" preload />
    <Font cssVariable="--font-inter" preload />

    <script is:inline>
      const theme = (() => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        return "dark";
      })();

      if (theme === "light") {
        document.documentElement.classList.add("light");
        document.documentElement.classList.remove("dark");
      } else {
        document.documentElement.classList.add("dark");
        document.documentElement.classList.remove("light");
      }
    </script>
  </head>
  <body class="bg-surface text-ink font-body min-h-svh relative flex flex-col scrollbar-none">
    <!-- HEADER -->
    <header class="z-20 fixed top-0 left-0 right-0 shrink-0 flex flex-row items-center justify-center p-2 bg-element border-b border-hairline shadow-xs shadow-accent-brand">
      <!-- NAVIGATION DRAWER TRIGGER -->
      <button
        aria-controls="navigation drawer"
        aria-expanded="false"
        aria-pressed="false"
        data-trigger="navigation drawer"
        type="button"
        class:list={[...buttonStyle]}>
        <Icon name="lucide:menu" />
      </button>

      <!-- BIBLE DRAWER TRIGGER -->
      <button
        aria-controls="bible drawer"
        aria-expanded="false"
        aria-pressed="false"
        data-trigger="bible drawer"
        type="button"
        class:list={[...buttonStyle, "ms-auto"]}>
        <Icon name="bible" />
      </button>
    </header>

    <!-- NAVIGATION DRAWER -->
    <nav
      aria-label="navigation drawer"
      data-target="navigation drawer"
      id="nav-drawer"
      class:list={[
        "fixed top-[49px] bottom-0 left-0 h-[calc(100svh-49px)] bg-element z-10 overflow-y-auto p-2 hidden",
      ]}>
      <ul class:list={["flex flex-col gap-y-2"]}>
        {() => {
          return (
            <>
              <li>
                <a class:list={[...buttonStyle]} href="/">
                  <Icon name="home" />
                </a>
              </li>
              <li>
                <button
                  aria-label="Toggle search"
                  aria-pressed="false"
                  class:list={[...buttonStyle]}
                  data-trigger="search toggle"
                  type="button">
                  <Icon name="search" />
                </button>
              </li>
              <li>
                <button
                  aria-label="Toggle bookmark"
                  aria-pressed="false"
                  class:list={[...buttonStyle]}
                  data-trigger="bookmark toggle"
                  type="button">
                  <Icon name="bookmark" />
                </button>
              </li>
              <li>
                <button
                  aria-label="Toggle dark theme"
                  aria-pressed="false"
                  class:list={[...buttonStyle]}
                  data-trigger="theme toggle"
                  type="button">
                  <span
                    aria-hidden="true"
                    class:list={["hidden"]}
                    data-trigger="theme light">
                    <Icon name="lucide:moon" />
                  </span>
                  <span
                    aria-hidden="false"
                    class:list={[""]}
                    data-trigger="theme dark">
                    <Icon name="lucide:sun" />
                  </span>
                </button>
              </li>
            </>
          );
        }}
      </ul>
    </nav>

    <!-- MAIN CONTENT-->
    <main class:list={["flex-1 bg-surface z-0 p-6 pt-[calc(24px+49px)]"]}>
      <div class:list={["border-b border-hairline"]}>
        <h1 class:list={["font-cinzel text-ink text-3xl"]}>
          {Astro.props.bookName} {Astro.props.chapterId}
        </h1>
      </div>

      <div class:list={["flex flex-col gap-y-3 py-4"]}>
        {Astro.props.verses &&
          Object.entries(Astro.props.verses).map(([verseNum, verse]) => {
            return (
              <p class:list={["font-scripture text-ink"]}>
                <span class:list={["text-subtle underline inline mr-2"]}>
                  {Astro.props.bookName.charAt(0).toUpperCase() +
                    Astro.props.bookName.slice(1, 3)}
                  {Astro.props.chapterId}:{verseNum}
                </span>
                <span class:list={["inline"]} set:html={verse} />
              </p>
            );
          })}
      </div>
    </main>

    <!-- BIBLE DRAWER -->
    <aside
      aria-label="Bible Drawer"
      data-target="bible drawer"
      id="bible-drawer"
      role="dialog"
      class:list={[
        "fixed top-[49px] bottom-0 h-[calc(100svh-49px)] bg-element z-10 overflow-y-auto flex-col gap-y-2 w-full scrollbar-none hidden",
      ]}>
      <h1
        class:list={[
          "font-cinzel text-ink text-2xl border-b border-hairline pt-2.5 pb-1 px-2 z-10 shadow shadow-accent-muted",
        ]}>
        Book
      </h1>
      <ul class:list={["flex flex-col gap-y-2 z-0"]}>
        {Astro.props._metadata.bookNames.map((name) => {
          const chapterCounts =
            Astro.props._metadata.chapterNumbersByBook[name] ?? [];
          return (
            <li class="w-full shadow shadow-accent-muted/50">
              <details class="group w-full">
                <summary class="flex items-center justify-between cursor-pointer list-none p-2 text-lg font-cinzel text-ink select-none">
                  <span>{name}</span>
                  <span class="transition-transform duration-200 group-open:rotate-180">
                    <Icon name="lucide:chevron-down" />
                  </span>
                </summary>

                <div class="px-2 pb-3 pt-1 text-sm bg-accent-muted/10 border-t border-accent-muted/20 flex flex-wrap gap-2">
                  {chapterCounts.map((count) => {
                    const href = `/reader/${Astro.props.translation}/${name.toLowerCase()}/${count}/`;
                    return (
                      <a
                        class:list={
                          "px-2 py-1 bg-accent-muted/20 rounded size-8 flex justify-center items-center"
                        }
                        href={href}>
                        {count}
                      </a>
                    );
                  })}
                </div>
              </details>
            </li>
          );
        })}
      </ul>
    </aside>
  </body>
</html>

<script>
  const elements = {
    bibleBtn: document.querySelector('[data-trigger="bible drawer"]'),
    bibleDrawer: document.querySelector('[data-target="bible drawer"]'),
    navigationBtn: document.querySelector('[data-trigger="navigation drawer"]'),
    navigationDrawer: document.querySelector(
      'nav[data-target="navigation drawer"]',
    ),
    themeBtn: document.querySelector('[data-trigger="theme toggle"]'),
    themeLightElement: document.querySelector('[data-trigger="theme light"]'),
    themeDarkElement: document.querySelector('[data-trigger="theme dark"]'),
  };

  // Helper function to handle aria states cleanly
  function updateAriaStates() {
    if (elements.bibleBtn && elements.bibleDrawer) {
      const isHidden = elements.bibleDrawer.classList.contains("hidden");
      elements.bibleBtn.setAttribute("aria-expanded", (!isHidden).toString());
      elements.bibleBtn.setAttribute("aria-pressed", (!isHidden).toString());
    }

    if (elements.navigationBtn && elements.navigationDrawer) {
      const isHidden = elements.navigationDrawer.classList.contains("hidden");
      elements.navigationBtn.setAttribute(
        "aria-expanded",
        (!isHidden).toString(),
      );
      elements.navigationBtn.setAttribute(
        "aria-pressed",
        (!isHidden).toString(),
      );
    }
  }

  // Bible toggle logic
  if (elements.bibleBtn && elements.bibleDrawer) {
    elements.bibleBtn.addEventListener("click", () => {
      // Close navigation drawer if open
      if (
        elements.navigationDrawer &&
        !elements.navigationDrawer.classList.contains("hidden")
      ) {
        elements.navigationDrawer.classList.add("hidden");
      }

      if (elements.bibleDrawer) {
        if (elements.bibleDrawer.classList.contains("hidden")) {
          elements.bibleDrawer.classList.remove("hidden");
          elements.bibleDrawer.classList.add("flex");
        } else {
          elements.bibleDrawer.classList.remove("flex");
          elements.bibleDrawer.classList.add("hidden");
        }
      }

      updateAriaStates();
    });
  }

  // Navigation toggle logic
  if (elements.navigationBtn && elements.navigationDrawer) {
    elements.navigationBtn.addEventListener("click", () => {
      // Close bible drawer if open
      if (
        elements.bibleDrawer &&
        !elements.bibleDrawer.classList.contains("hidden")
      ) {
        elements.bibleDrawer.classList.add("hidden");
      }

      if (elements.navigationDrawer) {
        elements.navigationDrawer.classList.toggle("hidden");
      }

      updateAriaStates();
    });
  }

  // Theme toggle logic
  if (
    elements.themeBtn &&
    elements.themeLightElement &&
    elements.themeDarkElement
  ) {
    elements.themeBtn.addEventListener("click", () => {
      const currentTheme = window.localStorage.getItem("theme");

      const applyTheme = (theme: "light" | "dark") => {
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
          document.documentElement.classList.remove("light");
        } else {
          document.documentElement.classList.add("light");
          document.documentElement.classList.remove("dark");
        }
      };

      const swapElementVisibility = (
        elementToShow: Element,
        elementToHide: Element,
      ) => {
        elementToShow.classList.remove("hidden");
        elementToShow.setAttribute("aria-hidden", "false");
        elementToHide.classList.add("hidden");
        elementToHide.setAttribute("aria-hidden", "true");
      };

      if (!currentTheme) {
        // If no theme is set, default to dark
        window.localStorage.setItem("theme", "dark");
        applyTheme("dark");

        if (elements.themeDarkElement && elements.themeLightElement) {
          swapElementVisibility(
            elements.themeDarkElement,
            elements.themeLightElement,
          );
        }
      } else {
        // If a theme is already set, toggle between light and dark
        if (currentTheme === "dark") {
          window.localStorage.setItem("theme", "light");

          if (elements.themeDarkElement && elements.themeLightElement) {
            swapElementVisibility(
              elements.themeLightElement,
              elements.themeDarkElement,
            );
          }
        } else {
          window.localStorage.setItem("theme", "dark");
          if (elements.themeDarkElement && elements.themeLightElement) {
            swapElementVisibility(
              elements.themeDarkElement,
              elements.themeLightElement,
            );
          }
        }

        // Apply the new theme immediately
        const newTheme = window.localStorage.getItem("theme") as
          "light" | "dark";
        applyTheme(newTheme);
      }
    });
  }
</script>
