---
import "../../../../../styles/global.css";
import { Font } from "astro:assets";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";

export const prerender = true;
export const getStaticPaths = (async () => {
  const hrbBible = await getCollection("hrb-bible");

  return [
    ...hrbBible.flatMap((object) => {
      const data = object.data;

      return {
        params: {
          book: data.bookName.toLowerCase(),
          chapter: String(data.chapterId),
          translation: "hrb",
        },
        props: {
          data,
        },
      };
    }),
  ];
}) satisfies GetStaticPaths;
---

<html lang="en" class:list={["dark scrollbar-none"]}>
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width" name="viewport" />
    <meta content={Astro.generator} name="generator" />
    <title>Sacred Scripture</title>
    <Font cssVariable="--font-cinzel" preload={true} />
    <Font cssVariable="--font-inter" preload={true} />
  </head>
  <body class:list={["bg-surface text-ink font-body flex flex-col gap-y-4"]}>
    <nav class:list={["navigation"]}>
      <button aria-label="home" type="button">
        <Icon name="home" />
      </button>

      <button aria-label="bible" type="button">
        <Icon name="bible" />
      </button>
    </nav>
    <main class:list={["py-4 px-6 min-h-svh"]}>
      <h1 class:list={["font-cinzel"]}>
        {Astro.props.data.bookName} {Astro.props.data.chapterId}
      </h1>
      <p class:list={["flex flex-col gap-1"]}>
        {Object.entries(Astro.props.data.verses).map(([key, value]) => {
          return (
            <div class:list={["font-scripture"]}>
              <strong>{key}:</strong>
              <span set:html={value} />
            </div>
          );
        })}
      </p>
    </main>
  </body>
</html>
