---
import "../styles/global.css";
import { Font } from "astro:assets";
import { Icon } from "astro-icon/components";
---

<html lang="en" class:list={["dark scrollbar-none"]}>
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width" name="viewport" />
    <meta content={Astro.generator} name="generator" />
    <title>Sacred Scripture</title>
    <Font cssVariable="--font-cinzel" preload={true} />
    <Font cssVariable="--font-inter" preload={true} />
  </head>
  <body
    class:list={[
      "bg-surface text-ink font-body flex flex-col gap-y-4 min-h-svh",
    ]}>
    <nav
      class:list={[
        "flex shrink-0 flex-row items-center justify-center p-2 bg-element border-b border-hairline shadow-xs shadow-accent-brand",
      ]}>
      <div class:list={["flex flex-row gap-x-2"]}>
        <a
          aria-label="home link"
          href="/"
          class:list={[
            "flex items-center justify-center size-8 text-xl text-subtle cursor-pointer bg-transparent border border-hairline rounded-lg transition-all duration-[120ms]",
          ]}>
          <Icon name="home" />
        </a>
        <a
          aria-label="home link"
          href="/reader/hrb/genesis/1/"
          class:list={[
            "flex items-center justify-center size-8 text-xl text-subtle cursor-pointer bg-transparent border border-hairline rounded-lg transition-all duration-[120ms]",
          ]}>
          <Icon name="bible" />
        </a>
        <button
          aria-label="theme"
          type="button"
          class:list={[
            "flex items-center justify-center size-8 text-xl text-subtle cursor-pointer bg-transparent border border-hairline rounded-lg transition-all duration-[120ms]",
          ]}>
          <Icon name="theme" />
        </button>
      </div>
    </nav>
    <slot />
  </body>
</html>

<script>
  // Toggle dark mode when the theme button is clicked
  const themeBtn = document.querySelector('button[aria-label="theme"]');
  themeBtn?.addEventListener("click", () => {
    document.documentElement.classList.toggle("dark");
  });
</script>
