---
import "@/styles/global.css";
import { Font } from "astro:assets";
import Header from "@/components/Header.astro";
import NavigationDrawer from "@/components/NavigationDrawer.astro";

export const prerender = true;

interface Props {
  bibleDrawer: boolean;
}

const styles = {
  buttons:
    "flex items-center justify-center size-10 text-xl text-subtle cursor-pointer bg-transparent border border-hairline rounded-lg transition-all duration-[120ms]",
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width" name="viewport" />
    <meta content={Astro.generator} name="generator" />
    <title>Sacred Scripture</title>
    <Font cssVariable="--font-cinzel" preload={false} />
    <Font cssVariable="--font-inter" preload={false} />
    <script is:inline>
      const theme = (() => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        return "dark";
      })();

      if (theme === "light") {
        document.documentElement.classList.add("light");
        document.documentElement.classList.remove("dark");
      } else {
        document.documentElement.classList.add("dark");
        document.documentElement.classList.remove("light");
      }
    </script>
  </head>
  <body class="bg-surface text-ink font-body min-h-svh relative flex flex-col scrollbar-none">
    <Header bibleDrawer={Astro.props.bibleDrawer} styles={styles} />
    <NavigationDrawer styles={styles} />
    <main class:list={["bg-surface z-0 p-6 pt-[calc(24px+57px)]"]}>
      <slot />
    </main>
  </body>
  <slot name="bibleDrawer" />
</html>

<script>
  import { initDrawerControls } from "../scripts/layout/drawers";
  import { initThemeToggle } from "../scripts/layout/theme";

  initDrawerControls();
  initThemeToggle();
</script>
